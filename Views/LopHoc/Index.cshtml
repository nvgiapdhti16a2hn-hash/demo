@model CourseListViewModel
@{
    ViewData["Title"] = "Danh sách lớp học";
}
<h1>Danh sách lớp học</h1>
<form method="get" class="filters">
    <div><label for="tuKhoa">Tìm lớp / chương trình</label><input id="tuKhoa" name="tuKhoa" value="@Model.TuKhoa" /></div>
    <div><label for="maChuongTrinh">Chương trình</label>
        <select id="maChuongTrinh" name="maChuongTrinh">
            <option value="">Tất cả</option>
            @foreach (var program in Model.ChuongTrinhs)
            {
                <option value="@program.MaChuongTrinhDaoTao" selected="@(Model.MaChuongTrinh == program.MaChuongTrinhDaoTao)">@program.TenChuongTrinhDaoTao</option>
            }
        </select>
    </div>
    <div><label for="trinhDo">Trình độ đầu vào</label><input id="trinhDo" name="trinhDo" value="@Model.TrinhDo" /></div>
    <div><label for="diemToiDa">Điểm đầu vào tối đa</label><input id="diemToiDa" name="diemToiDa" type="number" min="0" max="100" step="0.01" value="@Model.DiemToiDa" /></div>
    <div><label for="trangThai">Trạng thái</label>
        <select id="trangThai" name="trangThai">
            <option value="">Tất cả</option>
            @foreach (var state in Enum.GetValues<TrangThaiLop>())
            {
                <option value="@state" selected="@(Model.TrangThai == state)">@state.ToDisplayName()</option>
            }
        </select>
    </div>
    <div><label for="conHan">Thời hạn nhận hồ sơ</label>
        <select id="conHan" name="conHan">
            <option value="">Tất cả</option>
            <option value="true" selected="@(Model.ConHan == true)">Còn hạn</option>
            <option value="false" selected="@(Model.ConHan == false)">Hết hạn</option>
        </select>
    </div>
    <div><label for="sapXep">Sắp xếp</label>
        <select id="sapXep" name="sapXep">
            <option value="ten_az" selected="@(Model.SapXep == "ten_az")">Tên A-Z</option>
            <option value="ten_za" selected="@(Model.SapXep == "ten_za")">Tên Z-A</option>
            <option value="han_tang" selected="@(Model.SapXep == "han_tang")">Hạn đăng ký tăng</option>
            <option value="han_giam" selected="@(Model.SapXep == "han_giam")">Hạn đăng ký giảm</option>
            <option value="siso_tang" selected="@(Model.SapXep == "siso_tang")">Sĩ số tăng</option>
            <option value="siso_giam" selected="@(Model.SapXep == "siso_giam")">Sĩ số giảm</option>
        </select>
    </div>
    <div><button type="submit">Tìm kiếm</button></div>
</form>
<div id="course-results" aria-live="polite">
    <partial name="_CourseResults" model="Model" />
</div>
<div id="course-search-error" class="alert error" role="alert" hidden></div>

@section Scripts {
    <script>
        (() => {
            const form = document.querySelector(".filters");
            const results = document.getElementById("course-results");
            const error = document.getElementById("course-search-error");
            if (!(form instanceof HTMLFormElement) || !results || !error) return;

            let debounceTimer;
            let activeRequest;

            const loadResults = async (url, updateHistory) => {
                activeRequest?.abort();
                activeRequest = new AbortController();
                results.setAttribute("aria-busy", "true");
                error.hidden = true;

                try {
                    const response = await fetch(url, {
                        headers: { "X-Requested-With": "XMLHttpRequest" },
                        signal: activeRequest.signal
                    });
                    if (!response.ok) throw new Error(`Tải danh sách lớp thất bại (HTTP ${response.status}).`);

                    results.innerHTML = await response.text();
                    if (updateHistory) window.history.pushState({}, "", url);
                } catch (exception) {
                    if (exception.name === "AbortError") return;
                    error.textContent = exception instanceof Error ? exception.message : "Không thể tải danh sách lớp.";
                    error.hidden = false;
                } finally {
                    results.removeAttribute("aria-busy");
                }
            };

            const search = () => {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => {
                    const url = new URL(form.action, window.location.origin);
                    url.search = new URLSearchParams(new FormData(form)).toString();
                    loadResults(url, true);
                }, 250);
            };

            form.addEventListener("submit", event => {
                event.preventDefault();
                search();
            });
            form.addEventListener("input", event => {
                if (event.target instanceof HTMLInputElement) search();
            });
            form.addEventListener("change", search);
            results.addEventListener("click", event => {
                const link = event.target instanceof Element ? event.target.closest(".pagination a") : null;
                if (!(link instanceof HTMLAnchorElement) || link.origin !== window.location.origin) return;
                event.preventDefault();
                loadResults(link.href, true);
            });
            window.addEventListener("popstate", () => loadResults(window.location.href, false));
        })();
    </script>
}
