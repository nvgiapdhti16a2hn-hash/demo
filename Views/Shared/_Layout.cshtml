<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Quản lý khóa học</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">Đào tạo • UNETI</a>
        <nav>
            <a asp-controller="LopHoc" asp-action="Index">Lớp học</a>
            @if (Context.Session.GetString("AccountRole") == nameof(VaiTro.HocVien))
            {
                <a asp-controller="HocVien" asp-action="Sua">Hồ sơ cá nhân</a>
                <a asp-controller="HoSoDangKyHoc" asp-action="CuaToi">Hồ sơ đăng ký</a>
                <a asp-controller="ThongBao" asp-action="Index">Thông báo</a>
            }
            @if (Context.Session.GetString("AccountRole") is nameof(VaiTro.Admin) or nameof(VaiTro.NhanVienDaoTao))
            {
                <a asp-controller="QuanLyLopHoc" asp-action="Index">Quản lý lớp</a>
                <a asp-controller="HocVien" asp-action="DanhSach">Học viên</a>
                <a asp-controller="HoSoDangKyHoc" asp-action="DanhSach">Hồ sơ</a>
                <a asp-controller="TiepNhanHoSo" asp-action="Index">Xét duyệt</a>
                <a asp-controller="LichKiemTraDauVao" asp-action="Index">Lịch kiểm tra</a>
                <a asp-controller="ThongKe" asp-action="Index">Thống kê</a>
            }
            @if (Context.Session.GetString("AccountRole") == nameof(VaiTro.Admin))
            {
                <a asp-controller="ChuongTrinhDaoTao" asp-action="Index">Chương trình</a>
                <a asp-controller="QuanLyTaiKhoan" asp-action="Index">Tài khoản</a>
            }
        </nav>
        <div class="account">
            @if (Context.Session.GetInt32("AccountId") is not null)
            {
                <span>@Context.Session.GetString("AccountName") (@Context.Session.GetString("AccountRole"))</span>
                <form asp-controller="TaiKhoan" asp-action="DangXuat" method="post">
                    <button class="link-button" type="submit">Đăng xuất</button>
                </form>
            }
            else
            {
                <a asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a>
                <a asp-controller="TaiKhoan" asp-action="DangKy">Đăng ký</a>
            }
        </div>
    </header>
    <main class="container">
        @if (TempData["Success"] is string success)
        {
            <div class="alert success">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert error">@error</div>
        }
        @RenderBody()
    </main>
    <footer class="footer">Hệ thống quản lý khóa học và đăng ký học viên</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
